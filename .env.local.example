# Database
MONGODB_URI=mongodb://localhost:27017/carbon-bazaar

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# Environment
NODE_ENV=development

# Email Configuration (Optional - for sending verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@carbon-bazaar.com

# Application URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Maps API (for geocoding land locations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Sentinel Hub API (for satellite analysis)
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret
